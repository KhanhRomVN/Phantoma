{
  "name": "@phantoma/recon",
  "version": "1.0.0",
  "description": "Recon server for browser reconnaissance using CDP multi-browser automation",
  "main": "dist/index.js",
  "scripts": {
    "dev": "NODE_ENV=development nodemon",
    "build": "tsc",
    "start": "node dist/index.js"
  },
  "nodemonConfig": {
    "watch": ["src"],
    "ext": "ts,js,json",
    "exec": "tsx -r dotenv/config ./src/index.ts"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "puppeteer": "^21.0.0",
    "ws": "^8.14.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/cors": "^2.8.13",
    "@types/node": "^20.5.0",
    "@types/ws": "^8.5.5",
    "typescript": "^5.1.6",
    "tsx": "^3.12.7",
    "nodemon": "^3.1.14"
  }
}